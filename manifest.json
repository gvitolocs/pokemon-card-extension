{
  "manifest_version": 3,
  "name": "Pokemon Card Trader Linker",
  "version": "1.0",
  "description": "Converte i titoli delle inserzioni di carte Pokemon da eBay e Vinted in link cliccabili per CardTrader",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.ebay.it/*",
    "https://ebay.it/*",
    "https://www.ebay.com/*",
    "https://ebay.com/*",
    "https://www.vinted.it/*",
    "https://vinted.it/*",
    "https://www.vinted.com/*",
    "https://vinted.com/*",
    "https://www.cardtrader.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.it/*",
        "https://ebay.it/*",
        "https://www.ebay.com/*",
        "https://ebay.com/*",
        "https://www.vinted.it/*",
        "https://vinted.it/*",
        "https://www.vinted.com/*",
        "https://vinted.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pokemon Card Trader Linker"
  }
} 