{
  "manifest_version": 3,
  "name": "Pokemon Card Trader Linker",
  "version": "1.4.0",
  "description": "Converte i titoli delle inserzioni di carte Pokemon da eBay e Vinted in link cliccabili per CardTrader con integrazione Supabase",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.ebay.it/*",
    "https://ebay.it/*",
    "https://www.ebay.com/*",
    "https://ebay.com/*",
    "https://www.vinted.it/*",
    "https://vinted.it/*",
    "https://www.vinted.com/*",
    "https://vinted.com/*",
    "https://www.cardtrader.com/*",
    "https://*.supabase.co/*",
    "https://www.cardmarket.com/*",
    "https://cardmarket.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.it/*",
        "https://ebay.it/*",
        "https://www.ebay.com/*",
        "https://ebay.com/*",
        "https://www.vinted.it/*",
        "https://vinted.it/*",
        "https://www.vinted.com/*",
        "https://vinted.com/*",
        "https://www.cardmarket.com/*",
        "https://cardmarket.com/*"
      ],
      "js": [
        "supabase.js", 
        "api-config.js", 
        "supabase-config.js", 
        "supabase-integration.js",
        "core/ExtensionCore.js",
        "core/CacheManager.js",
        "ui/ButtonManager.js",
        "data/TitleExtractor.js",
        "utils/UrlGenerator.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pokemon Card Trader Linker",
    "default_icon": {
      "16": "icon-default.png",
      "32": "icon-default.png",
      "48": "icon-default.png",
      "128": "icon-default.png"
    }
  },
  "icons": {
    "16": "icon-default.png",
    "32": "icon-default.png",
    "48": "icon-default.png",
    "128": "icon-default.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["supabase-integration.js"],
      "matches": ["<all_urls>"]
    }
  ]
} 