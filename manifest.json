{
  "manifest_version": 3,
  "name": "Pokemon Card Trader Linker",
  "version": "1.4.0",
  "description": "Converts Pokemon card listing titles from eBay, Vinted, and Cardmarket into clickable CardTrader links with Supabase integration",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://www.ebay.it/*",
    "https://ebay.it/*",
    "https://www.ebay.com/*",
    "https://ebay.com/*",
    "https://www.vinted.it/*",
    "https://vinted.it/*",
    "https://www.vinted.com/*",
    "https://vinted.com/*",
    "https://www.cardtrader.com/*",
    "https://pokoin.com/*",
    "https://www.cardmarket.com/*",
    "https://cardmarket.com/*"
  ],
  "background": {
    "service_worker": "config/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.it/*",
        "https://ebay.it/*",
        "https://www.ebay.com/*",
        "https://ebay.com/*",
        "https://www.vinted.it/*",
        "https://vinted.it/*",
        "https://www.vinted.com/*",
        "https://vinted.com/*",
        "https://www.cardtrader.com/*",
        "https://cardtrader.com/*",
        "https://www.cardmarket.com/*",
        "https://cardmarket.com/*"
      ],
      "js": [
        "config/supabase.js", 
        "config/api-config.js", 
        "config/supabase-config.js", 
        "config/supabase-integration.js",
        "core/ExtensionCore.js",
        "core/CacheManager.js",
        "ui/ButtonManager.js",
        "data/TitleExtractor.js",
        "utils/UrlGenerator.js",
        "processors/PromoFilter.js",
        "processors/VINT.js",
        "processors/EBAYE.js",
        "processors/CME.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Pokemon Card Trader Linker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "ui-pages/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "config/supabase-integration.js",
        "assets/pokoin.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ]
} 