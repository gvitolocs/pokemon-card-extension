{
  "manifest_version": 3,
  "name": "Pokemon Card Trader Linker",
  "version": "1.4.0",
  "description": "Converte i titoli delle inserzioni di carte Pokemon da eBay e Vinted in link cliccabili per CardTrader con integrazione Supabase",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.ebay.it/*",
    "https://ebay.it/*",
    "https://www.ebay.com/*",
    "https://ebay.com/*",
    "https://www.vinted.it/*",
    "https://vinted.it/*",
    "https://www.vinted.com/*",
    "https://vinted.com/*",
    "https://www.cardtrader.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.it/*",
        "https://ebay.it/*",
        "https://www.ebay.com/*",
        "https://ebay.com/*",
        "https://www.vinted.it/*",
        "https://vinted.it/*",
        "https://www.vinted.com/*",
        "https://vinted.com/*"
      ],
      "js": ["supabase.js", "api-config.js", "supabase-config.js", "supabase-integration.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pokemon Card Trader Linker",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "web_accessible_resources": [
    {
      "resources": ["supabase-integration.js"],
      "matches": ["<all_urls>"]
    }
  ]
} 